# Copy to .env (cp .env.example .env). Member app — every variable it reads.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time: never put secrets here.

# Forum500 API base URL (backend, including /api)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Port: 3002 by default (package.json: next dev/start -p ${PORT:-3002}).
# Next.js does not read PORT from this file; set it in the shell instead: PORT=4005 npm run dev
# PORT=3002

# 1 = turn off Next.js anonymous telemetry
NEXT_TELEMETRY_DISABLED=1

  title           String
  eyebrow         String?
  subtitle        String?
  body            String?
  heroImageUrl    String?
  heroImageAlt    String?
  ctaLabel        String?
  ctaHref         String?
  /// Extra page sections: [{ key, eyebrow, title, body, imageUrl, imageAlt, ctaLabel, ctaHref }]
  blocks          Json?
  /// SEO description for public pages.
  metaDescription String?
  status          ContentStatus @default(published)
  createdAt       DateTime      @default(now()) @db.Timestamptz
  updatedAt       DateTime      @updatedAt @db.Timestamptz
  deletedAt       DateTime?     @db.Timestamptz
  createdBy       String?
  updatedBy       String?
  deletedBy       String?
}

enum NavMenu {

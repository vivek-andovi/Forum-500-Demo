  /// "local" (dev disk) or "s3".
  driver     String    @default("local")
  filename   String
  mime       String
  size       Int
  uploadedBy String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  createdBy  String?
  updatedBy  String?
  deletedBy  String?
}

/// Human-readable record of every admin change: who did what to which record.
model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  actorId     String?   @db.Uuid
  /// Snapshot of the actor at the time (kept even if the user is later deleted).
  actorEmail  String?
  actorName   String?
  action      String
  /// Resource key, e.g. "events".
  entity      String
  /// Human label of the resource type, e.g. "Event".
  entityType  String?
  entityId    String?
  /// Title of the affected record, e.g. "London Evening Salon & Dinner".
  entityLabel String?
  /// One-line description, e.g. "Updated Event “London Evening Salon” — Title, Capacity".
  summary     String?
  /// Field-level changes: [{ field, label, from, to }].
  changes     Json?
  ip          String?
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz
  createdBy   String?
  updatedBy   String?
  deletedBy   String?

  @@index([entity, entityId])
  @@index([createdAt])
}

/// Newsletter recipient. Members are linked; non-members (e.g. imported list subscribers) are not.
model Subscriber {
  id        String    @id @default(uuid()) @db.Uuid
  email     String    @unique
  name      String?
  /// subscribed | unsubscribed | unconfirmed | bounced | inactive
  status    String    @default("subscribed")
  lists     String[]  @default([])
  source    String?
  memberId  String?   @unique @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz
  createdBy String?
  updatedBy String?
  deletedBy String?

  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
}

/// Which record an imported legacy row (e.g. WordPress post 123) became. Makes imports re-runnable
/// and drives redirects from old URLs.
model LegacyMap {
  id        String    @id @default(uuid()) @db.Uuid
  /// Source system, e.g. "wordpress".
  source    String    @default("wordpress")
  /// Legacy entity, e.g. "user", "listing", "attachment", "message".
  entity    String
  legacyId  String
  /// Target model and id.
  model     String
  newId     String
  /// Old public URL (for redirects) and its replacement.
  oldUrl    String?
  newUrl    String?
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz
  createdBy String?
  updatedBy String?
  deletedBy String?

  @@unique([source, entity, legacyId])
  @@index([oldUrl])
}

// Forum500 — single source of truth for all data shown in the member app.
// Conventions: uuid ids, slugs where URLs need them, `status` + publish window for
// anything admins publish, timestamptz everywhere, money as cents + currency.
// Audit columns on every model: createdAt/updatedAt, createdBy/updatedBy/deletedBy (free text: the app
// writes the acting User id, but scripts/imports may write any label; null = system or a public form;
// no FK so history survives the user) and deletedAt for soft delete. Rows are never hard-deleted by the app: see src/core/prisma/audit-trail.extension.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum UserRole {
  admin
  member
}

enum UserStatus {
  invited
  active
  suspended
}

/// Shared lifecycle for admin-published content and member submissions.
enum ContentStatus {
  draft
  in_review
  scheduled
  published
  archived
  rejected
}

enum Visibility {
  public
  members
}

enum ProfileStatus {
  draft
  pending_review
  published
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum ApplicationStatus {
  new
  in_review
  approved
  rejected
  waitlisted
}

enum BenefitKind {
  member
  partner
}

enum MembershipRequestStatus {
  requested
  approved
  rejected
  left
}

enum EventKind {
  Salon
  Dinner
  Reception
  Roundtable
  Breakfast
  Lunch
  Brunch
  Drinks
  Conference
  Party
  Other
}

enum RsvpStatus {
  interested
  confirmed
  waitlisted
  declined
  cancelled
}

enum VenueCategory {
  Restaurants
  Clubs
  Studios
  Salons
  Hotels
  Private_homes
}

enum PhotoKind {
  Curated
  Candid
}

enum Publication {
  inforum
  forecast
  member
  /// Write-up of a club event (salon, breakfast, talk).
  report
}

enum PitchFormat {
  article
  dispatch
  interview
  photo_essay
  opinion
  forecast
}

enum RecommendationCategory {
  eat
  stay
  travel
  read
}

enum CommentTarget {
  edition
  article
  feed_post
}

enum LibraryKind {
  Annual_Report
  Journal
  audio
  video
  document
  link
}

enum IntroductionStatus {
  requested
  pending
  accepted
  declined
}

enum ActionType {
  review
  approve
  sign
  pay
  fill
}

enum ActionContext {
  Membership
  Events
  Media
  Communications
  Benefits
}

enum ActionStatus {
  pending
  completed
  dismissed
  overdue
}

enum CampaignStatus {
  draft
  scheduled
  sent
}

enum NotificationType {
  new_member
  rsvp_reminder
  publication
  profile_view
  approval
  general
}

enum ConciergeStatus {
  open
  answered
  closed
}

// ───────────────────────────── Identity ─────────────────────────────

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String?
  role         UserRole   @default(member)
  status       UserStatus @default(invited)
  lastLoginAt  DateTime?  @db.Timestamptz
  /// Incremented to revoke every token issued so far (logout-all, password change, suspension).
  tokenVersion Int        @default(0)
  /// Consecutive failed logins; the account locks temporarily after too many.
  failedLogins Int        @default(0)
  lockedUntil  DateTime?  @db.Timestamptz
  createdAt    DateTime   @default(now()) @db.Timestamptz
  updatedAt    DateTime   @updatedAt @db.Timestamptz
  deletedAt    DateTime?  @db.Timestamptz
  createdBy    String?
  updatedBy    String?
  deletedBy    String?

  member     Member?
  authTokens AuthToken[]
}

enum AuthTokenType {
  invite
  password_reset
  /// One-click sign-in link emailed on request (passwordless login).
  magic_link
}

/// One-time tokens for invite (set first password) and password-reset links.
/// Only a SHA-256 hash of the token is stored.
model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime      @db.Timestamptz
  usedAt    DateTime?     @db.Timestamptz
  createdAt DateTime      @default(now()) @db.Timestamptz
  updatedAt DateTime      @updatedAt @db.Timestamptz
  deletedAt DateTime?     @db.Timestamptz
  createdBy String?
  updatedBy String?
  deletedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────── Membership ────────────────────────────

model Chapter {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @unique
  country         String?
  isChapter       Boolean   @default(false) /// true = appears in directory/profile chapter list
  whatsappEnabled Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz
  deletedAt       DateTime? @db.Timestamptz
  createdBy       String?
  updatedBy       String?
  deletedBy       String?

  members        Member[]
  events         Event[]
  venues         Venue[]
  whatsappGroups WhatsappGroup[]
  albums         GalleryAlbum[]
}

model Sector {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz
  createdBy String?
  updatedBy String?
  deletedBy String?

  members       Member[]
  memberSectors MemberSector[]
}

model MembershipTier {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  priceCents  Int?
  currency    String    @default("GBP")
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz
  createdBy   String?
  updatedBy   String?
  deletedBy   String?

  members Member[]
}

/// The "five questions" every member answers on their profile.
model ProfileQuestion {
  id        String    @id @default(uuid()) @db.Uuid
  text      String
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz
  createdBy String?
  updatedBy String?
  deletedBy String?

  answers MemberQuestionAnswer[]
}

model Member {
  id                 String        @id @default(uuid()) @db.Uuid
  userId             String?       @unique @db.Uuid
  slug               String        @unique
  fullName           String
  headline           String?
  company            String?
  email              String?
  phone              String?
  bio                String?
  avatarUrl          String?
  linkedinUrl        String?
  interests          String[]      @default([])
  travelCities       String[]      @default([])
  joinedYear         Int?
  /// Full position line as entered, e.g. "LONDON | Chairman | Acme | Private Equity".
  positionLine       String?
  /// What the company does (the part of the position line after the company name).
  companyDescription String?
  verified           Boolean       @default(false)
  chapterId          String?       @db.Uuid
  sectorId           String?       @db.Uuid
  tierId             String?       @db.Uuid
  isPublished        Boolean       @default(true)
  profileStatus      ProfileStatus @default(published)
  /// Featured in "New Members" carousel + dashboard.
  featuredNewMember  Boolean       @default(false)
  /// Featured Q&A shown on the New Members card.
  spotlightQuestion  String?
  spotlightAnswer    String?
  /// Unsubmitted edits of a published member (ProfileInput JSON). Never shown to other members;
  /// goes live only via "Submit for review" → ProfileRevision → admin approval.
  profileDraft       Json?
  createdAt          DateTime      @default(now()) @db.Timestamptz
  updatedAt          DateTime      @updatedAt @db.Timestamptz
  deletedAt          DateTime?     @db.Timestamptz
  createdBy          String?
  updatedBy          String?
  deletedBy          String?

  user    User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  chapter Chapter?        @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  sector  Sector?         @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  tier    MembershipTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)

  answers              MemberQuestionAnswer[]
  interviews           MemberInterviewQA[]
  sectors              MemberSector[]
  subscriber           Subscriber?
  revisions            ProfileRevision[]
  benefitOffers        BenefitOffer[]
  benefitOptIns        BenefitOptIn[]
  groupMemberships     GroupMembership[]
  proposedGroups       Group[]                   @relation("GroupProposer")
  eventHosts           EventHost[]
  eventRsvps           EventRsvp[]
  proposedEvents       Event[]                   @relation("EventProposer")
  photoTags            MemberPhotoTag[]
  articles             Article[]
  pitches              Pitch[]
  recommendations      Recommendation[]
  comments             Comment[]
  commentRecommends    CommentRecommend[]
  podcastAppearances   PodcastEpisode[]
  books                Book[]
  bookRecommendations  BookRecommendation[]
  feedPosts            FeedPost[]
  feedLikes            FeedLike[]
  introsRequested      Introduction[]            @relation("IntroRequester")
  introsReceived       Introduction[]            @relation("IntroTarget")
  introsMade           Introduction[]            @relation("IntroIntroducer")
  whatsappMemberships  WhatsappMembership[]
  moderatedWhatsapp    WhatsappGroup[]           @relation("WhatsappModerator")
  emailDeliveries      EmailDelivery[]
  notifications        Notification[]
  actions              ActionItem[]
  conciergeRequests    ConciergeRequest[]
  conversations        ConversationParticipant[]
  sentMessages         Message[]
  whatsappMessages     WhatsappMessage[]
  applicationsReferred Application[]
}

/// All sectors a member works in (Member.sectorId stays the primary one).
model MemberSector {
  id        String    @id @default(uuid()) @db.Uuid
  memberId  String    @db.Uuid
  sectorId  String    @db.Uuid
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz
  createdBy String?
  updatedBy String?
  deletedBy String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@unique([memberId, sectorId])
}

model MemberQuestionAnswer {
  id         String    @id @default(uuid()) @db.Uuid
  memberId   String    @db.Uuid
  questionId String    @db.Uuid
  answer     String
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  createdBy  String?
  updatedBy  String?
  deletedBy  String?

  member   Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  question ProfileQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([memberId, questionId])
}

/// Long-form "new member interview" Q&A shown in the directory carousel.
model MemberInterviewQA {
  id        String    @id @default(uuid()) @db.Uuid
  memberId  String    @db.Uuid
  question  String
  answer    String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz
  createdBy String?
  updatedBy String?
  deletedBy String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

/// A member's submitted profile edit awaiting admin review.
model ProfileRevision {
  id           String       @id @default(uuid()) @db.Uuid
  memberId     String       @db.Uuid
  changes      Json
  status       ReviewStatus @default(pending)
  reviewerNote String?
  reviewedAt   DateTime?    @db.Timestamptz
  createdAt    DateTime     @default(now()) @db.Timestamptz
  updatedAt    DateTime     @updatedAt @db.Timestamptz
  deletedAt    DateTime?    @db.Timestamptz
  createdBy    String?
  updatedBy    String?
  deletedBy    String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model Application {
  id                  String            @id @default(uuid()) @db.Uuid
  fullName            String
  email               String
  phone               String?
  linkedin            String?
  role                String
  company             String
  sector              String
  city                String
  country             String
  travelCities        String[]          @default([])
  recommenderName     String
  recommenderMemberId String?           @db.Uuid
  recommenderRelation String?
  whyJoin             String
  contribution        String
  about               String?
  status              ApplicationStatus @default(new)
  decisionNote        String?
  decidedAt           DateTime?         @db.Timestamptz
  createdAt           DateTime          @default(now()) @db.Timestamptz
  updatedAt           DateTime          @updatedAt @db.Timestamptz
  deletedAt           DateTime?         @db.Timestamptz
  createdBy           String?
  updatedBy           String?
  deletedBy           String?

  recommender Member? @relation(fields: [recommenderMemberId], references: [id], onDelete: SetNull)
}

// ───────────────────────── Benefits & groups ─────────────────────────

model BenefitCategory {
  id        String      @id @default(uuid()) @db.Uuid
  name      String      @unique
  kind      BenefitKind
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now()) @db.Timestamptz
  updatedAt DateTime    @updatedAt @db.Timestamptz
  deletedAt DateTime?   @db.Timestamptz
  createdBy String?
  updatedBy String?
  deletedBy String?

  offers BenefitOffer[]
}

model BenefitOffer {
  id               String        @id @default(uuid()) @db.Uuid
  slug             String        @unique
  kind             BenefitKind
  title            String
  offer            String
  categoryId       String?       @db.Uuid
  providerMemberId String?       @db.Uuid
  providerName     String
  providerRole     String?
  location         String?
  about            String?
  detail           String?
  howToRedeem      String?
  imageUrl         String?
  companyImageUrl  String?
  featured         Boolean       @default(false)
  sortOrder        Int           @default(0)
  status           ContentStatus @default(published)
  publishAt        DateTime?     @db.Timestamptz
  unpublishAt      DateTime?     @db.Timestamptz
  createdAt        DateTime      @default(now()) @db.Timestamptz
  updatedAt        DateTime      @updatedAt @db.Timestamptz
  deletedAt        DateTime?     @db.Timestamptz
  createdBy        String?
  updatedBy        String?
  deletedBy        String?

  category       BenefitCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  providerMember Member?          @relation(fields: [providerMemberId], references: [id], onDelete: SetNull)
  optIns         BenefitOptIn[]
}

model BenefitOptIn {
  id        String    @id @default(uuid()) @db.Uuid
  memberId  String    @db.Uuid
  offerId   String    @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz
  createdBy String?
  updatedBy String?
  deletedBy String?

  member Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  offer  BenefitOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([memberId, offerId])
}

model Group {
  id           String        @id @default(uuid()) @db.Uuid
  slug         String        @unique
  name         String
  note         String?
  purpose      String?
  cadence      String?
  coverUrl     String?
  status       ContentStatus @default(published)
  proposedById String?       @db.Uuid
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now()) @db.Timestamptz
  updatedAt    DateTime      @updatedAt @db.Timestamptz
  deletedAt    DateTime?     @db.Timestamptz
  createdBy    String?
  updatedBy    String?
  deletedBy    String?

  proposedBy  Member?           @relation("GroupProposer", fields: [proposedById], references: [id], onDelete: SetNull)
  memberships GroupMembership[]
}

model GroupMembership {
  id        String                  @id @default(uuid()) @db.Uuid
  groupId   String                  @db.Uuid
  memberId  String                  @db.Uuid
  status    MembershipRequestStatus @default(requested)
  createdAt DateTime                @default(now()) @db.Timestamptz
  updatedAt DateTime                @updatedAt @db.Timestamptz
  deletedAt DateTime?               @db.Timestamptz
  createdBy String?
  updatedBy String?
  deletedBy String?

  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberId])
}

// ────────────────────────────── Events ──────────────────────────────

model Venue {
  id             String        @id @default(uuid()) @db.Uuid
  slug           String        @unique
  name           String
  chapterId      String?       @db.Uuid
  city           String
  category       VenueCategory
  access         String?
  description    String?
  imageUrl       String?
  privateAddress String?
  status         ContentStatus @default(published)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now()) @db.Timestamptz
  updatedAt      DateTime      @updatedAt @db.Timestamptz
  deletedAt      DateTime?     @db.Timestamptz
  createdBy      String?
  updatedBy      String?
  deletedBy      String?

  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  events  Event[]
}

model Event {
  id                 String        @id @default(uuid()) @db.Uuid
  slug               String        @unique
  title              String
  kind               EventKind
  city               String
  chapterId          String?       @db.Uuid
  venueId            String?       @db.Uuid
  venueText          String?
  startsAt           DateTime      @db.Timestamptz
  endsAt             DateTime?     @db.Timestamptz
  allDay             Boolean       @default(false)
  /// Human-friendly overrides used by the prototype (e.g. "All weekend").
  dateLabel          String?
  timeLabel          String?
  description        String?
  imageUrl           String?
  privateAddress     String?
  addressRevealHours Int           @default(48)
  capacity           Int?
  inviteAudiences    String[]      @default([])
  supportRequested   String[]      @default([])
  featured           Boolean       @default(false)
  status             ContentStatus @default(published)
  visibility         Visibility    @default(members)
  proposedById       String?       @db.Uuid
  reviewNote         String?
  createdAt          DateTime      @default(now()) @db.Timestamptz
  updatedAt          DateTime      @updatedAt @db.Timestamptz
  deletedAt          DateTime?     @db.Timestamptz
  createdBy          String?
  updatedBy          String?
  deletedBy          String?

  chapter    Chapter?       @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  venue      Venue?         @relation(fields: [venueId], references: [id], onDelete: SetNull)
  proposedBy Member?        @relation("EventProposer", fields: [proposedById], references: [id], onDelete: SetNull)
  hosts      EventHost[]
  rsvps      EventRsvp[]
  albums     GalleryAlbum[]
}

model EventHost {
  id        String    @id @default(uuid()) @db.Uuid
  eventId   String    @db.Uuid
  memberId  String    @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz
  createdBy String?
  updatedBy String?
  deletedBy String?

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
}

model EventRsvp {
  id          String     @id @default(uuid()) @db.Uuid
  eventId     String     @db.Uuid
  memberId    String     @db.Uuid
  status      RsvpStatus @default(confirmed)
  plusOnes    Int        @default(0)
  dietaryNote String?
  createdAt   DateTime   @default(now()) @db.Timestamptz
  updatedAt   DateTime   @updatedAt @db.Timestamptz
  deletedAt   DateTime?  @db.Timestamptz
  createdBy   String?
  updatedBy   String?
  deletedBy   String?

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
}

model GalleryAlbum {
  id        String        @id @default(uuid()) @db.Uuid
  slug      String        @unique
  title     String
  eventId   String?       @db.Uuid
  chapterId String?       @db.Uuid
  city      String
  dateLabel String
  takenOn   DateTime?     @db.Timestamptz
  coverUrl  String?
  status    ContentStatus @default(published)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now()) @db.Timestamptz
  updatedAt DateTime      @updatedAt @db.Timestamptz
  deletedAt DateTime?     @db.Timestamptz
  createdBy String?
  updatedBy String?
  deletedBy String?

  event   Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  chapter Chapter?       @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  photos  GalleryPhoto[]
}

model GalleryPhoto {
  id        String    @id @default(uuid()) @db.Uuid
  albumId   String    @db.Uuid
  caption   String?
  url       String
  kind      PhotoKind @default(Curated)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz
  createdBy String?
  updatedBy String?
  deletedBy String?

  album GalleryAlbum     @relation(fields: [albumId], references: [id], onDelete: Cascade)
  tags  MemberPhotoTag[]
}

model MemberPhotoTag {
  id        String    @id @default(uuid()) @db.Uuid
  memberId  String    @db.Uuid
  photoId   String    @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz
  createdBy String?
  updatedBy String?
  deletedBy String?

  member Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  photo  GalleryPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([memberId, photoId])
}

// ─────────────────────────────── Media ───────────────────────────────

model InforumSection {
  id        String    @id @default(uuid()) @db.Uuid
  key       String    @unique
  label     String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz
  createdBy String?
  updatedBy String?
  deletedBy String?

  articles Article[]
}

model InforumEdition {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  label       String
  publishedOn DateTime      @db.Timestamptz
  coverLine   String?
  coverUrl    String?
  /// The printed edition as a PDF.
  pdfUrl      String?
  status      ContentStatus @default(published)
  visibility  Visibility    @default(members)
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @updatedAt @db.Timestamptz
  deletedAt   DateTime?     @db.Timestamptz
  createdBy   String?
  updatedBy   String?
  deletedBy   String?

  articles EditionArticle[]
}

model EditionArticle {
  id        String    @id @default(uuid()) @db.Uuid
  editionId String    @db.Uuid
  articleId String    @db.Uuid
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz
  createdBy String?
  updatedBy String?
  deletedBy String?

  edition InforumEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  article Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([editionId, articleId])
}

model ForecastIssue {
  id            String        @id @default(uuid()) @db.Uuid
  slug          String        @unique
  issue         String
  title         String
  dateLabel     String
  publishedOn   DateTime?     @db.Timestamptz
  coverUrl      String?
  letterTitle   String?

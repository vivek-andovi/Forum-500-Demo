{
  "name": "forum500-backends",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:reset": "SEED_FORCE=1 prisma migrate reset --force",
    "check:types": "tsc --noEmit",
    "postinstall": "prisma generate",
    "check:layers": "node scripts/check-layers.mjs",
    "test:e2e": "node --test test/*.test.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "password:set": "node scripts/set-dev-password.mjs",
    "wp:import": "tsx scripts/import-wordpress/index.ts",
    "check:import": "tsc -p scripts/import-wordpress/tsconfig.json"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-ses": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "6.19.3",
    "argon2": "^0.44.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^18.0.8",
    "helmet": "^8.1.0",
    "prisma": "6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.20.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "^11.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.16.5",
    "mysql2": "^3.11.3",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "js-yaml": "^5.4.1"
  }
}

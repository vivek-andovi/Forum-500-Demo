# Copy to .env (cp .env.example .env). Forum500 API — every environment variable the backend reads (validated in src/core/config/env.ts).
# Empty values count as "not set", so the default in env.ts applies.

# ── Core
# development | test | production (production enforces a strong JWT_SECRET and S3_BUCKET with s3 storage)
NODE_ENV=development
# API port (default 4000)
PORT=4000
# Local: Docker Postgres (npm run db:up). AWS: RDS endpoint, e.g.
# postgresql://forum500:<password>@forum500.xxxxx.eu-west-2.rds.amazonaws.com:5432/forum500?schema=public&sslmode=require
DATABASE_URL=postgresql://forum500:forum500@localhost:5433/forum500?schema=public

# ── Auth
# 32+ random characters in production (openssl rand -base64 48). Store in AWS Secrets Manager.
JWT_SECRET=dev-only-change-me-in-production-000000
# Access-token lifetime (e.g. 15m, 12h, 1d)
JWT_EXPIRES_IN=60d

# ── URLs
# Frontends allowed to call the API (comma-separated; * = any)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# Public URL of this API, used for file and seed image links
PUBLIC_API_URL=http://localhost:4000
# Member app (invite / password-reset links) and admin app
WEB_APP_URL=http://localhost:3002
ADMIN_APP_URL=http://localhost:3001

# ── HTTP
# Swagger (/docs) is always on outside production; true also exposes it in production
ENABLE_SWAGGER=false
# true behind an AWS ALB / CloudFront (automatic when NODE_ENV=production)
TRUST_PROXY=false
# Requests per minute per IP for normal routes (login / forgot / apply have stricter fixed limits; default 300)
RATE_LIMIT_PER_MINUTE=2000

# ── File storage: local (dev, files in ./uploads) | s3 (AWS S3 or MinIO)
STORAGE_DRIVER=local
AWS_REGION=eu-west-2
# Required when STORAGE_DRIVER=s3
S3_BUCKET=
# Only for S3-compatible local testing (MinIO): http://localhost:9000 + S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# CloudFront distribution in front of the bucket, e.g. https://assets.forum500.club
ASSET_PUBLIC_BASE_URL=

# ── Email: log (prints to the console) | ses (Amazon SES)
MAIL_DRIVER=log
MAIL_FROM=Forum500 <no-reply@forum500.club>

# ── AWS credentials (S3 / SES). On AWS (ECS task role) leave these unset.
# Read directly by the AWS SDK; uncomment only for local testing against real AWS or LocalStack.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=

# ── Seed (npm run db:seed / db:reset)
SEED_ADMIN_EMAIL=admin@forum500.club
SEED_ADMIN_PASSWORD=Admin@12345
SEED_MEMBER_PASSWORD=Member@12345
# 1 = allow the seed to wipe a database that has real data. Never keep this on; pass it per command:
#   SEED_FORCE=1 npm run db:seed      (npm run db:reset already sets it)
# SEED_FORCE=1
# Docker image only: 1 = also seed on container start when the DB has no users (demo hosts like Railway)
# SEED_ON_START=1

# ── API e2e tests (npm run test:e2e) — URL of a running API on a throwaway, freshly seeded DB
# API_URL=http://localhost:4100/api

# Forum500 dev environment (your personal AWS + Cloudflare accounts).
# Copy to migrate/env/dev.env and fill in. dev.env is git-ignored: it holds secrets. Values with spaces or <> need quotes.
# Generate random secrets with:  openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
ENV_NAME_CHECK=dev

# ── AWS ────────────────────────────────────────────────────────────────────────────────────────────────
# A named CLI profile for your personal account:  aws configure --profile forum500-dev   (or aws login)
AWS_PROFILE=forum500-dev
AWS_REGION=eu-west-2

# ── Cloudflare ─────────────────────────────────────────────────────────────────────────────────────────
# Dashboard → right sidebar of any page shows the Account ID.
CF_ACCOUNT_ID=
# My Profile → API Tokens → Create token → Custom: "Account · Workers R2 Storage · Edit"
# (+ "Zone · DNS · Edit" and "Zone · Zone · Read" on your domain if you use R2_CUSTOM_DOMAIN). Used by the scripts only.
CF_API_TOKEN=

# ── R2 bucket (file storage) ───────────────────────────────────────────────────────────────────────────
R2_BUCKET=forum500-dev
# R2 → Manage API tokens → Create API token → "Object Read & Write", applied to forum500-dev only.
# This pair goes into the API (S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY) and the import.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional public domain for the files, e.g. assets-dev.example.com (the zone must be in this Cloudflare account).
# Leave empty to use the bucket's r2.dev address (fine for dev; Cloudflare rate-limits it).
R2_CUSTOM_DOMAIN=
CF_ZONE_ID=

# ── Database (RDS PostgreSQL) ──────────────────────────────────────────────────────────────────────────
DB_NAME=forum500
DB_USER=forum500
# 24+ random characters, letters and digits only (RDS refuses / @ " and spaces).
DB_PASSWORD=
DB_INSTANCE_CLASS=db.t4g.micro
# Lambda runs outside a VPC in dev and has no fixed IP, so the database must accept connections from anywhere
# (SSL is enforced; only the password protects it). Staging/prod use a private database instead.
DB_ALLOWED_CIDR=0.0.0.0/0

# ── API (Lambda) ───────────────────────────────────────────────────────────────────────────────────────
# 32+ random characters.
JWT_SECRET=
# Where the web and admin apps run in dev: locally against the cloud API. First = member app, second = admin.
WEB_ORIGINS=http://localhost:3002,http://localhost:3001
# log = emails printed to CloudWatch logs; ses = Amazon SES (verify your domain/address first, sandbox only
# delivers to verified addresses).
MAIL_DRIVER=log
MAIL_FROM="Forum500 Dev <no-reply@example.com>"
# Set once Cloudflare proxies the API (Transform Rule adds header x-origin-secret with this value). Empty = off.
ORIGIN_SECRET=
# The API's public address once Cloudflare proxies it (README §4.3), e.g. https://api-dev.example.com.
# Empty = the API Gateway address.
API_PUBLIC_URL=
LAMBDA_MEMORY_MB=1024
# Optional cap on simultaneous API instances (protects the small database). New AWS accounts often only have 10
# in total and AWS refuses any reservation then; leave empty in that case.
LAMBDA_RESERVED_CONCURRENCY=

# ── Local inputs for the data migration ────────────────────────────────────────────────────────────────
THINGS_DIR=/Users/plotify/Desktop/Forum500/Things
WP_DB_URL=mysql://root:localonly@127.0.0.1:3307/wp
# Local Docker Postgres, without a database name. The scripts create forum500_<env>_build there.
LOCAL_PG_URL=postgresql://forum500:CHANGE_ME@localhost:5433

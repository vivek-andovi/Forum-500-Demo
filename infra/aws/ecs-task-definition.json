{
  "family": "forum500-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": { "cpuArchitecture": "ARM64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/forum500-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/forum500-api-task-role",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/forum500-api:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 4000, "protocol": "tcp" }],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "4000" },
        { "name": "AWS_REGION", "value": "<REGION>" },
        { "name": "PUBLIC_API_URL", "value": "https://api.forum500.club" },
        { "name": "WEB_APP_URL", "value": "https://forum500.club" },
        { "name": "ADMIN_APP_URL", "value": "https://admin.forum500.club" },
        { "name": "CORS_ORIGINS", "value": "https://forum500.club,https://admin.forum500.club" },
        { "name": "STORAGE_DRIVER", "value": "s3" },
        { "name": "S3_BUCKET", "value": "forum500-assets-prod" },
        { "name": "ASSET_PUBLIC_BASE_URL", "value": "https://assets.forum500.club" },
        { "name": "MAIL_DRIVER", "value": "ses" },
        { "name": "MAIL_FROM", "value": "Forum500 <no-reply@forum500.club>" },
        { "name": "JWT_EXPIRES_IN", "value": "60d" },
        { "name": "RATE_LIMIT_PER_MINUTE", "value": "300" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:forum500/prod/api:DATABASE_URL::" },
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:forum500/prod/api:JWT_SECRET::" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:4000/api/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/forum500-api",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "api"
        }
      },
      "readonlyRootFilesystem": false,
      "user": "node"
    }
  ]
}
